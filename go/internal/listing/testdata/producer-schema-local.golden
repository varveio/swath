schema_id swath/local-entries/v1
message swath_listing
key_unique true
max_key_bytes 0
quoted_etag false
column key BYTE_ARRAY required delta
column size INT64 INT(64,true) optional max_bytes 0 accessor int
column last_modified INT64 TIMESTAMP(MICROS,UTC) optional max_bytes 0 accessor int
column kind BYTE_ARRAY STRING required max_bytes 0 accessor str
column mode INT32 INT(32,false) optional max_bytes 0 accessor int
column uid INT32 INT(32,false) optional max_bytes 0 accessor int
column gid INT32 INT(32,false) optional max_bytes 0 accessor int
column nlink INT32 INT(32,false) optional max_bytes 0 accessor int
column inode INT64 INT(64,false) optional max_bytes 0 accessor int
column dev INT64 INT(64,false) optional max_bytes 0 accessor int
column allocated_bytes INT64 INT(64,true) optional max_bytes 0 accessor int
column metadata_changed_at INT64 TIMESTAMP(MICROS,UTC) optional max_bytes 0 accessor int
column atime INT64 TIMESTAMP(MICROS,UTC) optional max_bytes 0 accessor int
column birth_time INT64 TIMESTAMP(MICROS,UTC) optional max_bytes 0 accessor int
column link_target BYTE_ARRAY optional max_bytes 4096 accessor str
