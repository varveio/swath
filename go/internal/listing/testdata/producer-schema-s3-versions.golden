schema_id swath/s3-versions/v1
message swath_listing
key_unique false
max_key_bytes 1024
column key BYTE_ARRAY STRING required delta
column size INT64 INT(64,true) optional max_bytes 0 accessor int
column last_modified INT64 TIMESTAMP(MICROS,UTC) optional max_bytes 0 accessor int
column etag BYTE_ARRAY STRING optional delta max_bytes 0 accessor str
column storage_class BYTE_ARRAY STRING optional max_bytes 0 accessor str
column owner_id BYTE_ARRAY STRING optional max_bytes 0 accessor str
column owner_display_name BYTE_ARRAY STRING optional max_bytes 0 accessor str
column checksum_algorithm BYTE_ARRAY STRING optional max_bytes 0 accessor str
column checksum_type BYTE_ARRAY STRING optional max_bytes 0 accessor str
column version_id BYTE_ARRAY STRING optional delta max_bytes 0 accessor str
column is_latest BOOLEAN required max_bytes 0 accessor bool
column is_delete_marker BOOLEAN required max_bytes 0 accessor bool
