# fish completion for swath; generated by swath completion fish

function __swath_key
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l words
    set -l skip 0
    for t in $tokens
        if test $skip -eq 1
            set skip 0
            continue
        end
        switch $t
            case --color --log-format
                set skip 1
            case '-*'
            case '*'
                set -a words $t
        end
    end
    switch "$words[1]"
        case ls
            echo list
        case diag
            string join ' ' -- $words[1] $words[2]
        case '*'
            echo $words[1]
    end
end

function __swath_cmd
    set -l key (__swath_key)
    contains -- "$key" $argv
end

