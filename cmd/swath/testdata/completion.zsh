        '--no-s3-path-style[address the bucket in the host name, also with --endpoint-url]' \
        '--s3-bearer-token-command=[a shell command printing a bearer token, sent instead of SigV4]:COMMAND: ' \
        '--s3-bearer-token-refresh-interval=[run --s3-bearer-token-command again after this long]:DURATION: ' \
        '--s3-fips[use the FIPS endpoint (s3-fips.REGION.amazonaws.com)]' \
        '--s3-dualstack[use the dual-stack (IPv6) endpoint]' \
        '--s3-fetch-owner[fill owner_id and owner_display_name]' \
        '(-h --help)'{-h,--help}'[print help]' \
        '1:source:_swath_source'
}

_swath_resume() {
    _arguments \
        '--output-gcs-credentials-file=[credentials for a GCS -o (default: Application Default Credentials)]:FILE:_files' \
        '--output-s3-profile=[the shared config profile an S3 -o takes credentials (and region) from]:NAME: ' \
        '--output-azure-sas-token=[a shared access signature for an Azure -o; never recorded]:TOKEN: ' \
        '(-j --workers)'{-j+,--workers=}'[listing workers (default 64; a local tree: 4 per CPU, at most 64)]:N: ' \
        '--encoders=[Parquet encoders, or a .zst file'\''s compression jobs (default: CPUs)]:N: ' \
        '--sort-buffer=[bytes buffered for sorted output; not a total-memory limit]:SIZE: ' \
        '--spill-budget=[cap on spill (default: half the output filesystem'\''s free space)]:SIZE: ' \
        '--part-interval=[close a part with rows after this long, full or not]:DURATION: ' \
        '--seed-from=[start from a previous listing'\''s key distribution, not the seed]:PATH:_files' \
        '--max-duration=[stop the run after this long (exit 124); 0: no limit]:DURATION: ' \
        '--stall-timeout=[stop as stuck after this long without progress (exit 75)]:DURATION: ' \
        '--report=[write the run report (JSON) to FILE, or - for stdout, at the end]:FILE:_files' \
        '(-v --verbose)'{-v,--verbose}'[a start line, progress records; -vv, -vvv: the request log]' \
        '(-q --quiet)'{-q,--quiet}'[no warnings, no automatic progress or statistics (-qq: no errors)]' \
        '--progress[show progress on stderr (default: a terminal that rows do not share)]' \
        '--no-progress[no live progress on stderr]' \
        '--progress-interval=[how often progress is printed (at least 1s); implies --progress]:DURATION: ' \
        '--stats[print the end-of-run statistics on stderr]' \
        '--no-stats[no end-of-run statistics on stderr]' \
        '--color=[color the progress line, the statistics and the help]:value:(auto always never)' \
        '--log-format=[stderr as text, or json: one JSON object per line]:value:(text json)' \
        '--no-spill-compress[write spill frames uncompressed (not zstd level 1)]' \
        '--spill-plain[write spill frames without delta coding (a comparison arm)]' \
        '--spill-reserve=[free space spill leaves on its filesystem (0: derived)]:SIZE: ' \
        '--trace=[write the range engine'\''s run trace (JSON Lines) to FILE]:FILE:_files' \
        '--anonymous[send no credentials (a public bucket or container)]' \
        '--ca-bundle=[trust the certificates in this PEM file besides the system'\''s]:FILE:_files' \
        '--no-verify-ssl[do not verify the service'\''s TLS certificate (warns)]' \
        '--request-timeout=[per-request timeout; a request over it is retried]:DURATION: ' \
        '--request-rate=[cap every HTTP attempt at N per second (0: no cap)]:N: ' \
        '--no-adaptive-limit[do not lower concurrency when the service throttles requests]' \
        '--adaptive-limit-slow-start[start the limit at 4 in flight, doubling each second to --workers]' \
        '--azure-sas-token=[a shared access signature (a query string); never recorded]:TOKEN: ' \
        '--gcs-credentials-file=[a service-account or authorized-user JSON file (default: ADC)]:FILE:_files' \
        '--s3-profile=[the shared config profile to take credentials and region from]:NAME: ' \
        '--s3-bearer-token-command=[a shell command printing a bearer token, sent instead of SigV4]:COMMAND: ' \
        '--s3-bearer-token-refresh-interval=[run --s3-bearer-token-command again after this long]:DURATION: ' \
        '--spill-compress[undo a recorded --no-spill-compress]' \
        '--no-spill-plain[undo a recorded --spill-plain]' \
        '--no-anonymous[undo a recorded --anonymous]' \
        '--verify-ssl[undo a recorded --no-verify-ssl]' \
        '--adaptive-limit[undo a recorded --no-adaptive-limit]' \
        '--no-adaptive-limit-slow-start[undo a recorded --adaptive-limit-slow-start]' \
        '(-h --help)'{-h,--help}'[print help]' \
        '1:directory:_files -/'
}

_swath_show() {
    _arguments \
        '(-v --verbose)'{-v,--verbose}'[a start line, progress records; -vv, -vvv: the request log]' \
        '(-q --quiet)'{-q,--quiet}'[no warnings, no automatic progress or statistics (-qq: no errors)]' \
        '--color=[color the progress line, the statistics and the help]:value:(auto always never)' \
        '--log-format=[stderr as text, or json: one JSON object per line]:value:(text json)' \
        '(-h --help)'{-h,--help}'[print help]' \
        '--journal[dump the journal'\''s header and records as JSON lines]' \
        '1:directory:_files -/'
}

_swath_diag() {
    local context state state_descr line
    typeset -A opt_args
    _arguments -C \
        '(-h --help)'{-h,--help}'[print help]' \
        '1:command:(list count)' \
        '*::arg:->args'
    case $line[1] in
    list) _swath_diag_list;;
    count) _swath_diag_count;;
    esac
}

_swath() {
    local context state state_descr line
    typeset -A opt_args
    _arguments -C \
        '(-v --verbose)'{-v,--verbose}'[a start line, progress records; -vv, -vvv: the request log]' \
        '(-q --quiet)'{-q,--quiet}'[no warnings, no automatic progress or statistics (-qq: no errors)]' \
        '--color=[color the progress line, the statistics and the help]:value:(auto always never)' \
        '--log-format=[stderr as text, or json: one JSON object per line]:value:(text json)' \
        '(-h --help)'{-h,--help}'[print help]' \
        '(-V --version)'{-V,--version}'[print the version]' \
        '1:command:->command' \
        '*::arg:->args'
    case $state in
    command)
        local -a commands
        commands=(
            'list:list SOURCE into a sorted Parquet dataset, or as text rows'
            'ls:list SOURCE into a sorted Parquet dataset, or as text rows'
            'du:total SOURCE'\''s objects and bytes, per prefix down to -d levels'
            'resume:continue an interrupted run'
            'show:show a dataset or an interrupted run'
            'diag:list or count with the diagnostic options (experiments, comparisons)'
            'completion:print a shell completion script (bash, zsh, fish)'
            'help:show a command'\''s help (swath help COMMAND)'
            'version:print the version'
        )
        _describe -t commands command commands;;
    args)
        case $line[1] in
        list|ls) _swath_list;;
        du) _swath_du;;
        resume) _swath_resume;;
        show) _swath_show;;
        diag) _swath_diag;;
        help) _arguments '1:command:(list ls du resume show diag completion help version)';;
        completion) _arguments '1:shell:(bash zsh fish)';;
        esac;;
    esac
}

if [ "$funcstack[1]" = _swath ]; then
    _swath "$@"
else
    compdef _swath swath
fi
