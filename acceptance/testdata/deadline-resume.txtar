# A dataset run stopped by --max-duration (exit 124) and resumed must give
# the same parts, byte for byte, as a run that was never stopped. The bucket
# holds 30,000 keys k/00001..k/30000 whose sizes are 1..30000 (450,015,000
# bytes). Served with 1 s per listing page of 1,000 keys to 2 workers, the 30
# pages take at least 15 s whatever the runner's speed (19 s measured on a
# Linux runner), and the first parts are durable after about 3 s (1,500 rows
# saved at 4 s, 10,500 at 9 s). The run is stopped at 9 s: three times the
# first commit, and 6 s before it could possibly finish. Parts close at 500
# rows, never by time (--part-interval 0), so their boundaries do not depend
# on timing.
#
# The replay server is the witness that the resume reuses what the stopped
# run saved (docs/resume-and-refresh.md: "It lists after the last saved
# key"): it logs every request it answers (--slow-request-log-ms 0), and no
# request of the resume without a continuation token may start below the
# last key of the parts the stopped run left in data/, which DuckDB reads
# (saved.sql, witness.sql). A request with a token is not checked: the log
# does not say where the token points.

seq keys.tsv 30000 'k/%05[1]d\t%[1]d\t1767225600000000'
replay --fixture keys.tsv --bucket bkt
env FAST=$REPLAY
# A server for the refused run alone, so that its log holds only what that
# run asked: a request the stopped run left in flight can still be logged
# after the stop, by the server it was sent to.
replay --fixture keys.tsv --bucket bkt --slow-request-log-ms 0
env REFUSED=$REPLAY
replay --fixture keys.tsv --bucket bkt --inject-latency worker_page=1000ms,pivot_probe=200ms,structure_probe=200ms --slow-request-log-ms 0

# The run that is never stopped, against a server without delays.
exec swath list s3://bkt --endpoint-url $FAST --anonymous -j 2 --part-interval 0 --part-max-rows 500 --sort-buffer 128KiB -o whole
json whole/manifest.json parts.59.rows extensions.swath.committed_object_bytes
stdout '\A500\n450015000\n\z'
! json whole/manifest.json parts.60

# The stopped run. It is not engaged unless it stops at the deadline (exit
# 124, not 0) with parts already committed.
exits 124 swath list s3://bkt --endpoint-url $REPLAY --anonymous -j 2 --part-interval 0 --part-max-rows 500 --sort-buffer 128KiB -o cut --max-duration 9s --report stopped.json
stderr '^  stopped: --max-duration reached; [0-9,]+ saved, [0-9,]+ listed in '
stderr '^swath: deadline: --max-duration reached \(swath resume cut --max-duration 0 continues it without a deadline; a plain resume keeps the recorded one\)$'
json stopped.json outcome.class outcome.exit_code outcome.resumable outcome.complete outcome.stop_source
stdout '\A"deadline"\n124\ntrue\nfalse\n"timebox"\n\z'
json stopped.json output.parts_written output.rows_durable
stdout '\A[1-9][0-9]*\n[1-9][0-9]*\n\z'
! exists cut/manifest.json
json cut/error.json class exit_code resumable status complete stop_source message
stdout '\A"deadline"\n124\ntrue\n"failed"\nfalse\n"timebox"\n"deadline: --max-duration reached"\n\z'
# The stopped run asked for the first page: no start-after, no continuation
# token. The server logs requests in this form, which witness.sql reads.
replaylog $REPLAY stopped.log
grep '^replay slow request shape=WORKER_PAGE ms=[0-9.]+ prefix=- delimiter=- start_after=- continuation=none max_keys=1000 entries=1000 truncated=true$' stopped.log

exec swath show cut
stdout '\Acut: interrupted run\n'
stdout '^  command   swath list --endpoint-url=http://127\.0\.0\.1:[0-9]+ --anonymous --workers=2 --part-interval=0 --part-max-rows=500 --sort-buffer=128KiB --output=cut --max-duration=9s --report=stopped\.json s3://bkt$'
stdout '^  saved     [1-9][0-9]* parts?, [0-9,]+ rows; swath resume lists after "k/[0-9]{5}"$'
[expect:v0.4.0] stdout '^  started   \d{4}-\d\d-\d\d \d\d:\d\d:\d\d \S+ \(journal version 1\)$'
[expect:v0.4.0] stdout '^  identity  provider s3, schema swath/s3-objects/v1, '
# #620: swath show leaves the journal version and the resume identity to -v.
[expect:current] stdout '^  started   \d{4}-\d\d-\d\d \d\d:\d\d:\d\d \S+$'
[expect:current] ! stdout '^  identity '

exec swath show -v cut
stdout '^  started   \d{4}-\d\d-\d\d \d\d:\d\d:\d\d \S+ \(journal version 1\)$'
stdout '^  identity  provider s3, schema swath/s3-objects/v1, .*, source s3://bkt/, endpoint http://127\.0\.0\.1:[0-9]+, '

# A new run over the interrupted one is refused, and changes nothing: every
# file in cut keeps its digest.
digests cut
cp stdout cut-before.txt
replaylog $REFUSED started.log
exits 2 swath list s3://bkt --endpoint-url $REFUSED --anonymous -o cut
cmp stderr refused.txt
! stdout .
digests cut
cmp stdout cut-before.txt
# It is refused before it sends any request.
replaylog $REFUSED refused.log
! grep . refused.log

# The last key of the parts saved before the resume, read from their files.
stdin saved.sql
exec duckdb -no-init -batch -bail -list -noheader -cmd 'SET VARIABLE run = ''cut'''
stdout '\Ak/[0-9]{5}\r?\n\z'

# The resume keeps the committed parts and lists the rest, after the last
# saved key: no request it sends without a continuation token starts below it.
exec swath resume cut --max-duration 0 --report resumed.json
replaylog $REPLAY cut-resumed.log
grep '^replay slow request shape=WORKER_PAGE ' cut-resumed.log
stdin witness.sql
exec duckdb -no-init -batch -bail -list -noheader -cmd 'SET VARIABLE run = ''cut'''
stdout '\Ak/[0-9]{5}\|[1-9][0-9]*\r?\n\z'
json resumed.json outcome.class outcome.exit_code outcome.complete output.parts_retained output.rows_retained output.rows_committed
stdout '\A"ok"\n0\ntrue\n[1-9][0-9]*\n[1-9][0-9]*\n30000\n\z'
! exists cut/error.json
exec swath show cut
stdout '\Acut: complete\n'
stdout '^  contents  30,000 objects, 429 MiB; keys "k/00001" \.\. "k/30000"$'

# The same parts as the run that was never stopped: the manifests name the
# same parts with the same digests, and each part's file has that digest.
json whole/manifest.json parts
cp stdout whole-parts.json
json cut/manifest.json parts
cmp stdout whole-parts.json
dataset whole 'SELECT count(*) FROM ds'
stdout '\A30000\n\z'
dataset cut 'SELECT key, size, epoch_us(last_modified), etag, storage_class, owner_id, owner_display_name, checksum_algorithm, checksum_type FROM ds'
seq want-rows.tsv 30000 'k/%05[1]d\t%[1]d\t1767225600000000\tNULL\tNULL\tNULL\tNULL\tNULL\tNULL'
cmp stdout want-rows.tsv

# A resume of a complete dataset has nothing to do, and changes nothing.
digests cut
cp stdout cut-before.txt
exec swath resume cut
cmp stdout complete.txt
! stderr .
digests cut
cmp stdout cut-before.txt

-- refused.txt --
swath: cut: output directory is not empty: it holds an interrupted run (swath resume DIR continues it; --overwrite starts over)
-- complete.txt --
cut is already complete: nothing to resume
-- saved.sql --
-- The last key of the parts the stopped run left in RUN/data/ (a part is
-- published there only once the journal has recorded it), kept in
-- RUN-saved.parquet for witness.sql, and printed.
COPY (SELECT max(key) AS key FROM read_parquet(getvariable('run') || '/data/*.parquet'))
  TO (getvariable('run') || '-saved.parquet') (FORMAT parquet);
FROM read_parquet(getvariable('run') || '-saved.parquet');
-- witness.sql --
-- The requests in RUN-resumed.log without a continuation token, whatever
-- their shape, must not start below the last key saved before the resume
-- (RUN-saved.parquet): the lowest key such a request can return is the
-- greater of its prefix and its start-after ("-": none). A request with a
-- token is left out: the log does not say where its token points. Prints the
-- saved key and how many requests were checked.
CREATE TEMP TABLE requests AS
  SELECT line, greatest(
      coalesce(nullif(regexp_extract(line, ' prefix=(\S*) ', 1), '-'), ''),
      coalesce(nullif(regexp_extract(line, ' start_after=(\S*) ', 1), '-'), '')) AS lowest
  FROM (SELECT unnest(string_split(content, chr(10))) AS line FROM read_text(getvariable('run') || '-resumed.log'))
  WHERE line LIKE 'replay slow request % continuation=none %';
CREATE TEMP TABLE saved AS FROM read_parquet(getvariable('run') || '-saved.parquet');
SELECT error(printf('the resume asked for keys from %s, below %s, the last key saved before it: %s', lowest, saved.key, line))
  FROM requests, saved WHERE lowest < saved.key;
SELECT saved.key, count(*) FROM requests, saved GROUP BY saved.key;
