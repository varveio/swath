# The command line a user and a script meet first: the version, the commands,
# the options the other scenarios rely on, and the exit code and message of
# each kind of mistake (docs/reference/exit-codes.md).

# The version line. The v0.4.0 feeder must hand over the release itself.
exec swath --version
[expect:v0.4.0] stdout '^swath 0\.4\.0 \(7e75c77f59c9cc31248e6d1326d9140cb8be5567\)\n$'
# A build of main says devel, or the release it is, and its commit.
[expect:current] stdout '^swath (devel|[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?) \([0-9a-f]{40}(-dirty)?\)\n$'
! stderr .
cp stdout version.txt
exec swath version
cmp stdout version.txt
exec swath -V
cmp stdout version.txt
exec swath-replay --version
[expect:v0.4.0] stdout '^swath-replay 0\.4\.0 \(7e75c77f59c9cc31248e6d1326d9140cb8be5567\)\n$'
[expect:current] stdout '^swath-replay (devel|[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?) \([0-9a-f]{40}(-dirty)?\)\n$'

# The commands, in this order, and the global options.
exec swath --help
stdout '^Usage: swath COMMAND \[OPTIONS\] \.\.\.$'
stdout -count=1 '(?s)\nCommands:\n  list, ls +\S.*\n  du +\S.*\n  resume +\S.*\n  show +\S.*\n  diag +\S.*\n  completion +\S.*\n  help +\S.*\n  version +\S.*\n\nOptions:\n'
stdout '^  -v, --verbose '
stdout '^  -q, --quiet '
stdout '^      --color auto\|always\|never$'
stdout '^      --log-format text\|json '
stdout '^  -h, --help '
stdout '^  -V, --version '
! stderr .
# Without a command, the short help (-h).
exec swath -h
cp stdout short-help.txt
exec swath
cmp stdout short-help.txt

# Each command's help: its usage lines and the options a user scripts with.
exec swath list --help
stdout '^Usage: swath list SOURCE \[OPTIONS\]\n       swath ls SOURCE \[OPTIONS\]\n'
stdout '^  -o, --output PATH '
stdout '^      --format auto\|table\|tsv\|jsonl$'
stdout '^      --no-header '
stdout '^      --columns NAME\[,NAME\.\.\.\]$'
stdout '^      --overwrite '
stdout '^      --include GLOB '
stdout '^      --exclude GLOB '
stdout '^      --include-regex REGEX '
stdout '^      --exclude-regex REGEX '
stdout '^      --min-size SIZE '
stdout '^      --max-size SIZE '
stdout '^      --modified-since TIME '
stdout '^      --modified-until TIME '
stdout '^      --anonymous '
stdout '^      --endpoint-url URL '
stdout '^      --s3-path-style '
stdout '^      --no-dirs '
stdout '^  -j, --workers N '
stdout '^      --sort-buffer SIZE '
stdout '^      --part-interval DURATION$'
stdout '^      --part-max-rows N '
stdout '^      --seed-from PATH '
stdout '^      --max-duration DURATION$'
stdout '^      --report FILE '
cp stdout list-help.txt
exec swath help list
cmp stdout list-help.txt

exec swath du --help
stdout '^Usage: swath du SOURCE \[OPTIONS\]\n       swath du --from-dataset DIR \[SOURCE\] \[OPTIONS\]\n'
stdout '^  -d, --depth N '
stdout '^  -l, --count-links '
stdout '^      --sort name\|size '
stdout '^      --from-dataset DIR '
stdout '^      --format auto\|table\|tsv\|jsonl$'
[expect:v0.4.0] stdout '^      --apparent-size '
# #660: -A is --apparent-size's short form, as du's.
[expect:current] stdout '^  -A, --apparent-size '

exec swath show --help
stdout '^Usage: swath show DIR \[OPTIONS\]\n'
stdout '^      --journal '

exec swath resume --help
stdout '^Usage: swath resume DIR \[OPTIONS\]\n'
stdout '^      --max-duration DURATION$'
stdout '^      --report FILE '

# The bash completion script: its header, the commands it offers, the options
# of list and du, the values of --format, and that bash can parse it.
exec swath completion bash
stdout '\A# bash completion for swath; generated by swath completion bash\n'
stdout '^    ''''\) COMPREPLY=\(\$\(compgen -W ''list ls du resume show diag completion help version'' -- "\$cur"\)\);;$'
stdout '^    ''list''\) echo ''--output -o --format --no-header --columns --overwrite .* --part-max-rows --seed-from --max-duration .* --report .* --anonymous --endpoint-url .* --no-dirs .* --help -h'';;$'
stdout '^    ''du''\) echo ''--depth -d --allocated --apparent-size .*--count-links -l --sort .* --from-dataset --format --no-header .* --help -h'';;$'
stdout '^    ''resume''\) echo ''.* --max-duration .* --report .* --help -h'';;$'
stdout '^    ''show''\) echo ''.* --journal'';;$'
stdout '^    --format\) echo ''enum auto table tsv jsonl'';;$'
stdout '^complete -F _swath swath\n\z'
[!windows] [exec:bash] cp stdout completion.bash
[!windows] [exec:bash] exec bash -n completion.bash

# Usage errors exit 2 with one line naming the mistake and where to look.
exits 2 swath nosuch
cmp stderr unknown-command
! stdout .
exits 2 swath list --nosuch .
cmp stderr unknown-flag
exits 2 swath list
cmp stderr missing-source
exits 2 swath list s3://
stderr '^swath: not an s3://bucket\[/prefix\] URL: "s3://"\nSee ''swath list --help''\.\n$'
exits 2 swath list ftp://host/x
stderr '^swath: unsupported source ftp://; SOURCE is a local directory or file, '
mkdir t
exits 2 swath list t --sort-buffer 1KiB -o out
stderr '^swath: --sort-buffer "1KiB": want at least 128KiB\n'
! exists out
exits 2 swath list t --report -
stderr '^swath: --report - prints the report on stdout, which carries the rows: give --report FILE\n'
! stdout .
exits 2 swath list t -o x.parquet
stderr '^swath: -o x\.parquet: a dataset is a directory of parts; '
! exists x.parquet

# Refusals exit 2 and change nothing: every file keeps its digest.
exec swath list t -o ds
exists ds/manifest.json
digests ds
cp stdout ds-before.txt
exits 2 swath list t -o ds
stderr '\Aswath: ds: output directory is not empty \(use --overwrite to replace a previous dataset\)\n\z'
digests ds
cmp stdout ds-before.txt
exits 2 swath resume t
stderr '\Aswath: nothing to resume: no interrupted run in the output directory\n\z'
digests t
! stdout .

# A source that does not exist is a failure a person fixes: exit 1, one line.
exits 1 swath list nosuchdir
stderr '^swath: nosuchdir: '
[!windows] cmp stderr no-such-dir
exits 1 swath show t
stderr '^swath: t holds neither a dataset nor an interrupted run\n$'

# --log-format json: one event per line, ending with the outcome.
exec swath du t --log-format json -v
stderr '^\{"ts":"[0-9TZ:.-]+","level":"info","event":"start",'
stderr '^\{"ts":"[0-9TZ:.-]+","level":"info","event":"outcome",.*"class":"ok","exit_code":0,.*"complete":true,"stop_reason":"end_of_scope","unreadable":0\}$'

-- unknown-command --
swath: unknown command "nosuch"
See 'swath --help'.
-- unknown-flag --
swath: unknown flag --nosuch
See 'swath list --help'.
-- missing-source --
swath: missing SOURCE
See 'swath list --help'.
-- no-such-dir --
swath: nosuchdir: no such file or directory
