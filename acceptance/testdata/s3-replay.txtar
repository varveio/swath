# A bucket served over the S3 API (ListObjectsV2) by swath-replay. The
# listing must equal the key list exactly: every key once, in unsigned byte
# order, whatever order the fixture gives them in. keys.tsv is hostile.tsv
# (14 keys, 100 bytes, newest 2026-06-01) and 2,500 keys zz/00001..zz/02500
# whose sizes are 1..2500 (3,126,250 bytes): 2,514 objects, 3,126,350 bytes.

cp hostile.tsv keys.tsv
seq keys.tsv 2500 'zz/%05[1]d\t%[1]d\t1767225600000000'
replay --fixture keys.tsv --bucket bkt --protocols s3

# The bare listing on a pipe: TSV, every column, every key, escaped.
exec swath list s3://bkt --endpoint-url $REPLAY --anonymous
cp want-hostile.tsv want-all.tsv
seq want-all.tsv 2500 'zz/%05[1]d\t%[1]d\t2026-01-01T00:00:00.000000Z\t\\N\t\\N\t\\N\t\\N\t\\N\t\\N'
cmp stdout want-all.tsv

exec swath list s3://bkt --endpoint-url $REPLAY --anonymous --exclude 'zz/**' --format jsonl
cmp stdout want-hostile.jsonl

# Filters and columns. An include with a literal prefix narrows the listing.
exec swath list s3://bkt --endpoint-url $REPLAY --anonymous --include 'z/*' --columns key,size --report narrowed.json
cmp stdout want-z.tsv
json narrowed.json invocation.narrowing invocation.source
stdout '\A"narrowed"\n"s3://bkt/z/"\n\z'
exec swath list s3://bkt --endpoint-url $REPLAY --anonymous --storage-class GLACIER --columns key,storage_class
stdout '\Akey\tstorage_class\nB\tGLACIER\n\z'
exec swath list s3://bkt --endpoint-url $REPLAY --anonymous --modified-since 2026-03-01T00:00:00Z --columns key,last_modified --no-header
stdout '\Aa/x\t2026-06-01T00:00:00\.000000Z\n\z'
exec swath list s3://bkt --endpoint-url $REPLAY --anonymous --exclude 'zz/**' --min-size 10 --max-size 13 --columns key
stdout '\Akey\nnew\\nline\ntab\\there\nz/～\nz/😀\n\z'

# Totals, from the listing and from the key list.
exec swath du s3://bkt --endpoint-url $REPLAY --anonymous
stdout '\Arow_type\tdepth\tobjects\tsize\tsize_missing\tallocated_bytes\tallocated_bytes_missing\tmax_last_modified\tprimary\tsort\tlinks_once\tprefix\n'
stdout '\ntotal\t0\t2514\t3126350\t0\t\\N\t2514\t2026-06-01T00:00:00\.000000Z\tsize\tname\tfalse\t\n\z'
exec swath du s3://bkt --endpoint-url $REPLAY --anonymous -d 1 --format jsonl
cmp stdout want-du-1.jsonl

# The dataset, in parts of at most 1,000 rows.
exec swath list s3://bkt --endpoint-url $REPLAY --anonymous -o ds --part-max-rows 1000 --report report.json
! stdout .
exists ds/manifest.json ds/run.json ds/cuts.txt
! exists ds/error.json
json ds/run.json outcome.class outcome.exit_code outcome.complete output.rows_committed
stdout '\A"ok"\n0\ntrue\n2514\n\z'
dataset ds 'SELECT * FROM ds_schema'
cmp stdout want-schema.tsv
dataset ds 'SELECT column_name, column_type FROM (DESCRIBE ds)'
cmp stdout want-types.tsv
# Every column of every row; a key with a tab, line feed or backslash as hex.
dataset ds 'SELECT * REPLACE (CASE WHEN regexp_matches(key, ''[\t\n\\]'') THEN ''hex:'' || hex(key) ELSE key END AS key, epoch_us(last_modified) AS last_modified) FROM ds'
cp want-rows-hostile.tsv want-rows.tsv
seq want-rows.tsv 2500 'zz/%05[1]d\t%[1]d\t1767225600000000\tNULL\tNULL\tNULL\tNULL\tNULL\tNULL'
cmp stdout want-rows.tsv

json ds/manifest.json format format_version draft_revision schema_id key extensions.swath.version extensions.swath.source extensions.swath.scope extensions.swath.coverage.complete extensions.swath.coverage.stop_reason extensions.swath.coverage.unreadable extensions.swath.coverage.filters extensions.swath.coverage.exclusions extensions.swath.collected extensions.swath.committed_object_bytes
cmp stdout want-manifest.txt
json ds/manifest.json parts.0.path parts.0.rows parts.0.min_key_base64 parts.1.path parts.1.rows parts.2.path parts.2.rows parts.2.max_key_base64
cmp stdout want-parts.txt
! json ds/manifest.json parts.3
json report.json outcome.class outcome.exit_code outcome.status outcome.complete output.rows_committed output.committed_object_bytes invocation.schema_id
stdout '\A"ok"\n0\n"committed"\ntrue\n2514\n3126350\n"swath/s3-objects/v1"\n\z'

exec swath show ds
stdout -count=6 '\n'
stdout '\Ads: complete\n'
stdout '^  source    s3://bkt \(whole bucket\)$'
stdout '^  contents  2,514 objects, 2\.98 MiB; keys "B" \.\. "zz/02500"$'
stdout '^  coverage  nothing unreadable; no filters; no exclusions$'
[expect:v0.4.0] stdout '^  storage   3 parts, [0-9.]+ KiB of Parquet \(SeekParquet format 0 draft 1, schema swath/s3-objects/v1\)$'
# #620: swath show names the storage by its parts and schema; -v adds the format id.
[expect:current] stdout '^  storage   3 parts, [0-9.]+ KiB of Parquet \(schema swath/s3-objects/v1\)$'

# Totals from the dataset agree with the key list, and name the listing
# they come from.
exec swath du --from-dataset ds -d 1 --format jsonl
cmpform stdout want-saved-du-1.jsonl

