# A container served over the Azure Blob API (List Blobs) by swath-replay.
# The listing must equal the key list exactly: every name once, in unsigned
# byte order. Azure lists in UTF-16 code-unit order, which puts z/😀 (U+1F600)
# before z/～ (U+FF5E); swath must put them back in byte order. keys.tsv is
# hostile.tsv (12 names, 79 bytes, newest 2026-06-01; Azure refuses control
# characters in a name) and 2,500 names zz/00001..zz/02500 whose sizes are
# 1..2500 (3,126,250 bytes): 2,512 blobs, 3,126,329 bytes. The server fills
# what a key list does not give (etag, blob type, tier, lease state) with
# fixed synthetic values.

cp hostile.tsv keys.tsv
seq keys.tsv 2500 'zz/%05[1]d\t%[1]d\t1767225600000000'
replay --fixture keys.tsv --bucket bkt --protocols azure

# The bare listing on a pipe: TSV, every column, every name, escaped.
exec swath list az://replay/bkt --endpoint-url $REPLAY --anonymous
cp want-hostile.tsv want-all.tsv
seq want-all.tsv 2500 'zz/%05[1]d\t%[1]d\t2026-01-01T00:00:00.000000Z\t0x000000000000001\t\\N\tapplication/octet-stream\tBlockBlob\tHot\t\\N\ttrue\t\\N\t\\N\t\\N\t\\N\t\\N\t\\N\t\\N\t\\N\tavailable\t\\N\t\\N\t\\N\t\\N\t\\N\t\\N'
cmp stdout want-all.tsv

exec swath list az://replay/bkt --endpoint-url $REPLAY --anonymous --exclude 'zz/**' --format jsonl --columns key,size,last_modified,blob_type
cmp stdout want-hostile.jsonl

# Filters.
exec swath list az://replay/bkt --endpoint-url $REPLAY --anonymous --include 'z/*' --columns key,size --report narrowed.json
cmp stdout want-z.tsv
json narrowed.json invocation.narrowing invocation.source
[expect:v0.4.0] stdout '\A"provider_lists_root"\n"az://replay/bkt"\n\z'
# #621: an include with a literal prefix narrows an Azure listing, as on S3 and GCS.
[expect:current] stdout '\A"narrowed"\n"az://replay/bkt/z/"\n\z'
exec swath list az://replay/bkt --endpoint-url $REPLAY --anonymous --storage-class Hot --exclude 'zz/**' --include 'a?b' --columns key,storage_class
stdout '\Akey\tstorage_class\na b\tHot\na-b\tHot\na\.b\tHot\n\z'
exec swath list az://replay/bkt --endpoint-url $REPLAY --anonymous --exclude-regex '^zz/' --exclude-regex '^a' --max-size 9 --columns key
stdout '\Akey\nB\nback\\\\slash\ncafé\n\z'
exec swath list az://replay/bkt --endpoint-url $REPLAY --anonymous --modified-since 2026-03-01T00:00:00Z --columns key,last_modified --no-header
stdout '\Aa/x\t2026-06-01T00:00:00\.000000Z\n\z'

# Totals.
exec swath du az://replay/bkt --endpoint-url $REPLAY --anonymous
stdout '\Arow_type\tdepth\tobjects\tsize\tsize_missing\tallocated_bytes\tallocated_bytes_missing\tmax_last_modified\tprimary\tsort\tlinks_once\tprefix\n'
stdout '\ntotal\t0\t2512\t3126329\t0\t\\N\t2512\t2026-06-01T00:00:00\.000000Z\tsize\tname\tfalse\t\n\z'
exec swath du az://replay/bkt --endpoint-url $REPLAY --anonymous -d 1 --format jsonl
cmp stdout want-du-1.jsonl

# The dataset, in parts of at most 1,000 rows.
exec swath list az://replay/bkt --endpoint-url $REPLAY --anonymous -o ds --part-max-rows 1000 --report report.json
! stdout .
exists ds/manifest.json ds/run.json ds/cuts.txt
! exists ds/error.json
dataset ds 'SELECT * FROM ds_schema'
cmp stdout want-schema.tsv
dataset ds 'SELECT column_name, column_type FROM (DESCRIBE ds)'
cmp stdout want-types.tsv
dataset ds 'SELECT CASE WHEN regexp_matches(key, ''[\t\n\\]'') THEN ''hex:'' || hex(key) ELSE key END, size, epoch_us(last_modified), etag, content_type, blob_type, storage_class, storage_class_inferred, lease_state, metadata, tags FROM ds'
cp want-rows-hostile.tsv want-rows.tsv
seq want-rows.tsv 2500 'zz/%05[1]d\t%[1]d\t1767225600000000\t0x000000000000001\tapplication/octet-stream\tBlockBlob\tHot\ttrue\tavailable\tNULL\tNULL'
cmp stdout want-rows.tsv

json ds/manifest.json format schema_id key extensions.swath.version extensions.swath.source extensions.swath.scope extensions.swath.coverage.complete extensions.swath.coverage.stop_reason extensions.swath.coverage.unreadable extensions.swath.coverage.filters extensions.swath.coverage.exclusions extensions.swath.collected extensions.swath.committed_object_bytes
cmp stdout want-manifest.txt
json ds/manifest.json parts.0.rows parts.0.min_key_base64 parts.1.rows parts.2.rows parts.2.max_key_base64
stdout '\A1000\n"Qg=="\n1000\n512\n"enovMDI1MDA="\n\z'
! json ds/manifest.json parts.3
json report.json outcome.class outcome.exit_code outcome.status outcome.complete output.rows_committed output.committed_object_bytes invocation.schema_id
stdout '\A"ok"\n0\n"committed"\ntrue\n2512\n3126329\n"swath/azure-objects/v1"\n\z'

exec swath show ds
stdout -count=6 '\n'
stdout '\Ads: complete\n'
stdout '^  source    az://replay/bkt \(whole container\)$'
stdout '^  contents  2,512 objects, 2\.98 MiB; keys "B" \.\. "zz/02500"$'
stdout '^  coverage  nothing unreadable; no filters; no exclusions$'
[expect:v0.4.0] stdout '^  storage   3 parts, [0-9.]+ KiB of Parquet \(SeekParquet format 0 draft 1, schema swath/azure-objects/v1\)$'
# #620: swath show names the storage by its parts and schema; -v adds the format id.
[expect:current] stdout '^  storage   3 parts, [0-9.]+ KiB of Parquet \(schema swath/azure-objects/v1\)$'

exec swath du --from-dataset ds -d 1 --format jsonl
stdout '\A\{"row_type":"total","depth":0,"prefix":"","objects":2512,"size":3126329,'
stdout '^\{"row_type":"prefix","depth":1,"prefix":"zz/","objects":2500,"size":3126250,'

