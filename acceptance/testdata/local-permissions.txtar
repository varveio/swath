# A directory the user cannot read: every command still writes its output,
# leaves the directory's contents out, says so, and exits 3 (incomplete).
# The readable part of tree.spec is 2 files of 5+70 = 75 bytes and 2
# directories; locked/hidden.txt (1000 bytes) must be missing everywhere.

[windows] skip 'chmod 000 does not make a directory unreadable on Windows'

mktree p tree.spec
chmod 000 p/locked
# The suite must not run as root, which reads the directory anyway.
! exists p/locked/hidden.txt

[expect:v0.4.0] env PRIMARY=size
# #660: a local tree whose listing reads blocks leads with the space on disk.
[expect:current] env PRIMARY=allocated_bytes
exits 3 swath du p
cmpform stdout want-du.tsv
[expect:current] stderr '\Aswath: warning: unreadable entries:\n  locked: permission denied\n  partial: 1 unreadable entry; 2 files, 2 directories, '
[expect:v0.4.0] [!darwin] stderr '\Aswath: warning: unreadable entries:\n  locked: permission denied\n  partial: 1 unreadable entry; 2 files, 2 directories, '
# 0.4.0 on macOS gave the open error's text, the absolute path in it; #651
# (#647) opens each directory relative to its parent there, as on Linux.
[expect:v0.4.0] [darwin] stderr '\Aswath: warning: unreadable entries:\n  locked: open \Q'$WORK'\E/p/locked: permission denied\n  partial: 1 unreadable entry; 2 files, 2 directories, '
[expect:v0.4.0] stderr '^  partial: 1 unreadable entry; 2 files, 2 directories, 75 B in '
# #660: the closing line gives the space on disk, the figure that leads.
[expect:current] stderr '^  partial: 1 unreadable entry; 2 files, 2 directories, [0-9.]+ [KMG]?i?B on disk in '

exits 3 swath list p --columns key,kind,size --no-dirs
cmp stdout want-files.tsv
stderr '^  partial: 1 unreadable entry; 2 entries, 75 B in '

# The partial dataset holds the readable entries and says what it lacks.
exits 3 swath list p -o pds --report report.json
! stdout .
stderr '^  partial: 1 unreadable entry; 4 entries, 75 B in .* → pds \(1 part, '
exists pds/manifest.json pds/run.json
! exists pds/error.json
dataset pds 'SELECT decode(key), kind, size, epoch_us(last_modified) FROM ds'
cmpform stdout want-rows.tsv
json pds/manifest.json extensions.swath.coverage.complete extensions.swath.coverage.stop_reason extensions.swath.coverage.unreadable extensions.swath.committed_object_bytes
stdout '\Afalse\n"end_of_scope"\n1\n75\n\z'
json report.json outcome.class outcome.exit_code outcome.resumable outcome.status outcome.complete outcome.unreadable output.rows_committed
stdout '\A"incomplete"\n3\nfalse\n"committed"\nfalse\n1\n4\n\z'
json pds/run.json outcome.class outcome.exit_code outcome.complete outcome.unreadable output.rows_committed
stdout '\A"incomplete"\n3\nfalse\n1\n4\n\z'

exec swath show pds
stdout '\Apds: partial: 1 unreadable entry\n'
stdout '^  contents  4 entries, 75 B; keys "locked/" \.\. "top"$'
stdout '^  coverage  1 entry unreadable; no filters; no exclusions$'

# Totals of the partial dataset: the readable entries, and the coverage.
exits 3 swath du --from-dataset pds --apparent-size --format jsonl
cmpform stdout want-saved-du.jsonl
stderr '^swath: 1 entry could not be read when the dataset was listed: the totals leave it out$'

# Fixing the permission and listing again gives the whole tree.
chmod 755 p/locked
exec swath list p -o pds --overwrite
! exists pds/error.json
dataset pds 'SELECT decode(key), kind, size, epoch_us(last_modified) FROM ds'
cmpform stdout want-rows-fixed.tsv
json pds/manifest.json extensions.swath.coverage.complete extensions.swath.coverage.stop_reason extensions.swath.coverage.unreadable extensions.swath.committed_object_bytes
stdout '\Atrue\n"end_of_scope"\n0\n1075\n\z'

-- tree.spec --
dir locked 2026-01-01T00:00:00Z
file locked/hidden.txt 1000 2026-01-09T00:00:00Z
dir open 2026-01-01T00:00:00Z
file open/f 5 2026-01-05T00:00:00Z
file top 70 2026-01-02T00:00:00Z
-- want-du.tsv --
row_type	depth	objects	dirs	size	size_missing	allocated_bytes	allocated_bytes_missing	max_last_modified	primary	sort	links_once	prefix
total	0	2	2	75	0	{int}	0	2026-01-05T00:00:00.000000Z	$PRIMARY	name	true	
-- want-files.tsv --
key	kind	size
open/f	file	5
top	file	70
-- want-rows.tsv --
locked/	dir	{int}	1767225600000000
open/	dir	{int}	1767225600000000
open/f	file	5	1767571200000000
top	file	70	1767312000000000
-- want-saved-du.jsonl --
{"row_type":"total","depth":0,"prefix":"","objects":2,"dirs":2,"size":75,"size_missing":0,"allocated_bytes":{int},"allocated_bytes_missing":0,"max_last_modified":"2026-01-05T00:00:00.000000Z","primary":"size","sort":"name","links_once":true,"dataset":{"path":"pds","source":"$WORK/p","schema_id":"swath/local-entries/v1","listing_started_at":"{time}","listing_finished_at":"{time}","complete":false,"stop_reason":"end_of_scope","unreadable":1,"filters":[],"exclusions":[]}}
-- want-rows-fixed.tsv --
locked/	dir	{int}	1767225600000000
locked/hidden.txt	file	1000	1767916800000000
open/	dir	{int}	1767225600000000
open/f	file	5	1767571200000000
top	file	70	1767312000000000
