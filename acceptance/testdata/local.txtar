# A local tree with hostile names, listed as text, as totals and as a dataset.
# Every expected key, size, time, mode and total below follows from
# tree.spec: 9 files of 1+20+300+4000+50000+6+70+800+0 = 55197 bytes, 6
# directories below the root, newest file 2026-06-01, files mode 0644 (420)
# and directories 0755 (493) as mktree sets them, each file one link and
# never read (so accessed at its modification time). What the filesystem
# decides (a directory's own size, link count and access time, the group,
# inode, device, allocated bytes, change and birth times) is checked for its
# form only: {int} and {time} in the cmpform blocks.

mktree t tree.spec

# Platform facts. Windows reports a file's mode as 0666 (438) and a
# directory's as 0777 (511) whatever mktree asks, a directory's size as 0,
# and reads no owner, link count, inode, device, blocks or change time: those
# are null, every file lacks allocated bytes, and du cannot tell two names of
# one file apart (links_once false). A Linux listing reads no birth time;
# macOS and Windows record one.
[linux] env BORN=\N BORN_US=NULL
[darwin] env BORN={time} BORN_US={int}

# Every entry, in unsigned byte order of the key: ' ' < '-' < '.' < '/' < '0'
# puts a/ and a/x between a.txt and a0, and B before a.
exec swath list t --columns key,kind
cmp stdout want-keys.tsv
! stderr .

exec swath list t --no-dirs --columns key,size,last_modified
cmp stdout want-files.tsv

# The bare output on a pipe: TSV, this header, every column of every entry.
exec swath list t
[!windows] cmpform stdout want-bare.tsv
[windows] cmpform stdout want-bare-windows.tsv
! stderr .

exec swath list t --format jsonl --columns key,size,last_modified,kind --no-dirs
cmp stdout want-files.jsonl

# Filters select rows: a glob without '/' matches the last segment at any
# depth; dir/** drops the rows below a directory; sizes bound files.
exec swath list t --include '*.txt' --columns key
cmp stdout want-txt.tsv
exec swath list t --exclude 'ünïcødé/**' --exclude 'a/**' --exclude 'deep/**' --no-dirs --columns key
cmp stdout want-excluded.tsv
exec swath list t --no-dirs --min-size 300 --max-size 4000 --columns key,size
cmp stdout want-sized.tsv
exec swath list t --include-regex '^a[^/]' --no-header --columns key
cmp stdout want-regex.tsv

# A text file named by -o: its extension picks the format.
exec swath list t -o rows.tsv --no-dirs --columns key,size,last_modified
! stdout .
cmp rows.tsv want-files.tsv

# Totals. The bare output on a pipe is TSV, the total first.
[expect:v0.4.0] env PRIMARY=size
# #660: a local tree whose listing reads blocks leads with the space on disk.
[expect:current] [!windows] env PRIMARY=allocated_bytes
# #660: Windows reads no blocks, so the lengths lead.
[expect:current] [windows] env PRIMARY=size
exec swath du t
[!windows] cmpform stdout want-du.tsv
[windows] cmpform stdout want-du-windows.tsv

exec swath du t -d 1 --apparent-size --format jsonl
[!windows] cmpform stdout want-du-1.jsonl
[windows] cmpform stdout want-du-1-windows.jsonl

# The table names the zone it prints times in (TZ is UTC; Windows keeps the runner's zone).
[!windows] exec swath du t -d 1 --format table --apparent-size
[!windows] [expect:v0.4.0] cmp stdout want-du-table-v040.txt
# #620: the table heads the newest time under a prefix newest, as the view does.
[!windows] [expect:current] cmp stdout want-du-table.txt
[!windows] stderr '^  53\.9 KiB in 9 files · [0-9.]+ [KMG]?i?B on disk$'

# A filter leaves out the directories and the files it does not select.
exec swath du t --include '*.txt' --apparent-size --format tsv --no-header
[!windows] cmpform stdout want-du-txt.tsv
[windows] cmpform stdout want-du-txt-windows.tsv

# The dataset: its parts' schema, its rows in stored order, its manifest and
# its run report.
exec swath list t -o ds --report report.json
! stdout .
stderr '^  complete: 15 entries, '
exists ds/manifest.json ds/run.json ds/data/part-00000.parquet
! exists ds/error.json
[expect:v0.4.0] exists ds/cuts.txt
# #620: a dataset of a local tree has no cuts.txt.
[expect:current] ! exists ds/cuts.txt

dataset ds 'SELECT * FROM ds_schema'
cmp stdout want-schema.tsv
dataset ds 'SELECT column_name, column_type FROM (DESCRIBE ds)'
cmp stdout want-types.tsv
dataset ds 'SELECT decode(key), kind, size, epoch_us(last_modified), mode, uid, gid, nlink, inode, dev, allocated_bytes, epoch_us(metadata_changed_at), epoch_us(accessed_at), epoch_us(created_at), decode(link_target) FROM ds'
[!windows] cmpform stdout want-rows.tsv
[windows] cmpform stdout want-rows-windows.tsv

json ds/manifest.json format format_version draft_revision schema_id key extensions.swath.version
cmp stdout want-manifest-head.txt
json ds/manifest.json extensions.swath.source.kind extensions.swath.scope extensions.swath.coverage.complete extensions.swath.coverage.stop_reason extensions.swath.coverage.unreadable extensions.swath.coverage.filters extensions.swath.coverage.exclusions extensions.swath.collected extensions.swath.committed_object_bytes
cmp stdout want-manifest-swath.txt
json ds/manifest.json parts.0.rows parts.0.min_key_base64 parts.0.max_key_base64
cmp stdout want-manifest-part.txt
json ds/manifest.json extensions.swath.filesystem.total_bytes
stdout '^[1-9][0-9]*$'
[expect:v0.4.0] ! json ds/manifest.json extensions.swath.written_by
# #644: the manifest records the build that wrote it.
[expect:current] json ds/manifest.json extensions.swath.written_by.tool
[expect:current] stdout '^"swath"$'

json report.json report_version build.tool outcome.class outcome.exit_code outcome.status outcome.complete outcome.stop_reason outcome.unreadable output.rows_committed output.committed_object_bytes invocation.schema_id
cmp stdout want-report.txt
json ds/run.json outcome.class outcome.exit_code outcome.complete output.rows_committed
stdout '\A"ok"\n0\ntrue\n15\n\z'

exec swath show ds
stdout -count=6 '\n'
stdout '\Ads: complete\n'
stdout '^  source    .*[/\\]t \(whole tree\)$'
stdout '^  listed    \d{4}-\d\d-\d\d \d\d:\d\d:\d\d to \d\d:\d\d:\d\d \S+ \(\d+\.\ds\)$'
stdout '^  contents  15 entries, 53\.9 KiB; keys "B\.txt" \.\. "ünïcødé/日本語/ファイル 名\.txt"$'
stdout '^  coverage  nothing unreadable; no filters; no exclusions$'
[expect:v0.4.0] stdout '^  storage   1 part, [0-9.]+ KiB of Parquet \(SeekParquet format 0 draft 1, schema swath/local-entries/v1\)$'
# #620: swath show names the storage by its parts and schema; -v adds the format id.
[expect:current] stdout '^  storage   1 part, [0-9.]+ KiB of Parquet \(schema swath/local-entries/v1\)$'

exec swath show -v ds
[expect:v0.4.0] stdout '^  storage   1 part, [0-9.]+ KiB of Parquet \(SeekParquet format 0 draft 1, schema swath/local-entries/v1\)$'
# #620, #644: -v adds the SeekParquet format id, and the build that wrote the manifest.
[expect:current] stdout '^  storage   1 part, [0-9.]+ KiB of Parquet \(SeekParquet format 0 draft 1, schema swath/local-entries/v1, written by swath \S+ revision [0-9a-f]{40}(-dirty)?\)$'

# Totals from the dataset agree with the tree, the hard links aside (none
# here), and name the listing they come from.
exec swath du --from-dataset ds --apparent-size --format jsonl
[!windows] cmpform stdout want-saved-du.jsonl
[windows] cmpform stdout want-saved-du-windows.jsonl

# A non-empty output is refused, and left as it was; --overwrite replaces
# the dataset.
digests ds
cp stdout ds-before.txt
exits 2 swath list t -o ds
cmp stderr refused.txt
digests ds
cmp stdout ds-before.txt
exec swath list t -o ds --overwrite --include '*.txt'
json ds/manifest.json extensions.swath.coverage.filters parts.0.rows extensions.swath.committed_object_bytes
stdout '\A\[\{"filter":"include","value":"\*\.txt"\}\]\n4\n4876\n\z'
dataset ds 'SELECT decode(key), size FROM ds'
cmp stdout want-txt-rows.tsv
exec swath show ds
stdout '^  coverage  nothing unreadable; filtered: include=\*\.txt; no exclusions$'

# A path longer than Windows' 260 characters.
mktree long long.spec
exec swath list long --no-dirs --columns key,size
cmp stdout want-long.tsv

# A name that is not UTF-8 (Linux allows any byte but '/' and NUL): TSV
# writes the byte as \xHH, JSONL gives the exact bytes in key_base64, and the
# dataset holds them as they are.
[linux] mktree nu nonutf8.spec
[linux] exec swath list nu --columns key,size
[linux] cmp stdout want-nonutf8.tsv
[linux] exec swath list nu --format jsonl --columns key,size
[linux] stdout '\A\{"key":null,"key_base64":"YmFk/25hbWU=","size":3\}\n\z'
[linux] exec swath list nu -o nuds
[linux] dataset nuds 'SELECT hex(key), size FROM ds'
[linux] stdout '\A626164FF6E616D65\t3\n\z'

# A file with two names is counted once by du, under each name with -l
# (Windows reads no link counts); the dataset holds both names with the
# file's one inode and two links.
[!windows] mktree h hardlink.spec
[!windows] exec swath du h --apparent-size --format jsonl
[!windows] cmpform stdout want-du-h.jsonl
[!windows] exec swath du h -l --apparent-size --format jsonl
[!windows] cmpform stdout want-du-h-l.jsonl
[!windows] exec swath list h -o hds
[!windows] dataset hds 'SELECT decode(key), nlink, inode = (SELECT inode FROM ds WHERE decode(key) = ''f'') FROM ds'
[!windows] cmp stdout want-h-rows.tsv
[!windows] exec swath du --from-dataset hds --apparent-size --format jsonl
[!windows] cmpform stdout want-saved-du-h.jsonl

# A symbolic link is an entry of its own, with its target.
[symlink] mktree sl symlink.spec
[symlink] symlink sl/l -> f
[symlink] exec swath list sl --columns key,kind,link_target
[symlink] cmp stdout want-symlink.tsv

-- tree.spec --
dir a 2026-01-01T00:00:00Z
file a/x 1 2026-03-01T00:00:00Z
file "a b" 20 2026-01-02T00:00:00Z
file a-b 300 2026-01-03T00:00:00Z
file a.txt 4000 2026-01-04T00:00:00Z
file a0 50000 2026-01-05T00:00:00Z
file B.txt 6 2026-01-06T00:00:00Z
file "café crème.txt" 70 2026-01-07T00:00:00Z
dir ünïcødé 2026-01-01T00:00:00Z
dir ünïcødé/日本語 2026-01-01T00:00:00Z
file "ünïcødé/日本語/ファイル 名.txt" 800 2026-06-01T00:00:00Z
dir empty 2026-01-01T00:00:00Z
dir deep 2026-01-01T00:00:00Z
dir deep/er 2026-01-01T00:00:00Z
file deep/er/z.bin 0 2026-02-01T00:00:00Z
